!     y2 = int(end_date[0:4])
!     m2 = int(end_date[5:7])
!     d2 = int(end_date[8:10])
!     def _is_leap(year):
!         return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)
!     def _days_in_year(year):
!         return 366 if _is_leap(year) else 365
!     def _day_of_year(year, month, day):
!         dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
!         if _is_leap(year):
!             dim[1] = 29
!         return sum(dim[:month - 1]) + day
!     if y1 == y2:
!         return _day_of_year(y2, m2, d2) - _day_of_year(y1, m1, d1)
!     total = _days_in_year(y1) - _day_of_year(y1, m1, d1)
!     for y in range(y1 + 1, y2):
!         total += _days_in_year(y)
!     total += _day_of_year(y2, m2, d2)
!     return total
  
  
